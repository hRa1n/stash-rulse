name: 美团开屏去广告
desc: 独立拦截美团开屏广告
category: 去广告

script-providers:
  meituan_skip:
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
    interval: 86400

http:
  script:
    - match: ^https?:\/\/.*meituan\.com\/api\/v\d+\/loadInfo\?
      name: meituan_skip
      match-req: false
      match-resp: true
      require-body: true
      timeout: 10

mitm:
  - "*.meituan.com"
